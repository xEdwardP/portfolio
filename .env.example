# Copy this file to .env and replace the placeholders with real values.
#   cp .env.example .env
#
# The three PUBLIC_ values below are REQUIRED: the build fails and names the
# missing one rather than publishing a placeholder. Set them in the Cloudflare
# Pages dashboard to change the deployed site without touching code.
#
# Every value here ships inside the generated HTML. Never put a real secret in
# this file or in .env — none of these are private.

PUBLIC_CONTACT_EMAIL=you@example.com
PUBLIC_GITHUB_URL=https://github.com/your-username
PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/your-profile

# Optional. Access key for the contact form provider — get one at https://web3forms.com,
# it is tied to the destination inbox. Leave it empty and the form tells visitors
# it is not configured yet, offering the email address instead.
PUBLIC_WEB3FORMS_KEY=
