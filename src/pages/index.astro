---
import { defaultLocale, locales } from '@/i18n/config';

const fallback = `/${defaultLocale}/`;
---

<!doctype html>
<html lang={defaultLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={fallback} />
    <title>Edward Pineda</title>
    <script is:inline define:vars={{ locales, fallback }}>
      const match = navigator.languages
        .map((tag) => tag.split('-')[0])
        .find((tag) => locales.includes(tag));

      window.location.replace(match ? `/${match}/` : fallback);
    </script>
    <noscript>
      <meta http-equiv="refresh" content="0; url=/es/" />
    </noscript>
  </head>
  <body>
    <a href={fallback}>Continuar / Continue</a>
  </body>
</html>
