---
import { Font } from 'astro:assets';
import ThemeScript from '@/features/theme/ThemeScript.astro';
import { defaultLocale, htmlLang, locales } from '@/i18n/config';
import { localizePath } from '@/i18n/utils';
import { ui } from '@/i18n/ui';
import '@/styles/global.css';

const columns = locales.map((locale) => ({
  locale,
  title: ui[locale]['error.title'],
  body: ui[locale]['error.body'],
  home: ui[locale]['error.home'],
  href: localizePath('', locale),
}));
---

<!doctype html>
<html lang={htmlLang[defaultLocale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeScript />
    <title>404 — {ui[defaultLocale]['site.title']}</title>
    <meta name="robots" content="noindex" />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-general-sans" preload />
  </head>

  <body class="flex min-h-screen flex-col bg-bg font-sans text-text">
    <main class="mx-auto flex w-full max-w-2xl flex-1 flex-col justify-center px-4 py-16">
      <p class="animate-rise font-mono text-sm text-accent">404</p>

      <div class="mt-8 grid gap-10 sm:grid-cols-2">
        {
          columns.map((column, index) => (
            <section
              lang={htmlLang[column.locale]}
              class="animate-rise"
              style={`animation-delay: ${index * 80}ms`}
            >
              <h1 class="font-display text-2xl font-bold tracking-tight sm:text-3xl">
                {column.title}
              </h1>
              <p class="mt-3 text-muted">{column.body}</p>
              <a
                href={column.href}
                class="mt-5 inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-on-accent transition hover:bg-accent-hover"
              >
                {column.home}
              </a>
            </section>
          ))
        }
      </div>
    </main>
  </body>
</html>
