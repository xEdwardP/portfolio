---
import { Icon } from 'astro-icon/components';
import BaseLayout from '@/shared/layouts/BaseLayout.astro';
import Button from '@/shared/components/ui/Button.astro';
import Card from '@/shared/components/ui/Card.astro';
import Section from '@/shared/components/ui/Section.astro';
import { ecosystems } from '@/data/profile';
import { locales, type Locale } from '@/i18n/config';
import { localizePath, useTranslations } from '@/i18n/utils';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);
---

<BaseLayout>
  <Section width="wide" class="py-16 sm:py-24">
    <p class="font-mono text-sm text-accent">{t('home.eyebrow')}</p>
    <h1
      class="mt-3 max-w-3xl font-display text-4xl leading-tight font-bold tracking-tight sm:text-6xl"
    >
      {t('home.title')}
    </h1>
    <p class="mt-5 max-w-xl text-lg text-muted">{t('home.lead')}</p>

    <div class="mt-8 flex flex-wrap gap-3">
      <Button href={localizePath('/projects', locale)}>
        {t('home.cta.projects')}
        <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
      </Button>
      <Button href={localizePath('/contact', locale)} variant="secondary">
        {t('home.cta.contact')}
      </Button>
    </div>
  </Section>

  <Section width="wide" title={t('home.stack')}>
    <ul class="grid grid-cols-2 gap-4 sm:grid-cols-4">
      {
        ecosystems.map((ecosystem) => (
          <li>
            <Card class="flex flex-col items-center gap-2 py-6">
              <Icon
                name={ecosystem.icon}
                class:list={['size-7', ecosystem.color]}
                aria-hidden="true"
              />
              <span class="text-sm font-medium">{ecosystem.label}</span>
            </Card>
          </li>
        ))
      }
    </ul>
  </Section>
</BaseLayout>
