---
import { render } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '@/shared/layouts/BaseLayout.astro';
import Section from '@/shared/components/ui/Section.astro';
import Badge from '@/shared/components/ui/Badge.astro';
import Prose from '@/shared/components/ui/Prose.astro';
import ContentLink from '@/shared/components/ui/ContentLink.astro';
import { getPosts, readingMinutes, slugOf } from '@/features/blog/queries';
import { tagLabel } from '@/data/tags';
import { locales, type Locale } from '@/i18n/config';
import { localizePath, useTranslations } from '@/i18n/utils';
import { formatDate, isoDate } from '@/shared/lib/format';

export async function getStaticPaths() {
  const paths = await Promise.all(
    locales.map(async (locale) => {
      const posts = await getPosts(locale);
      return posts.map((post) => ({
        params: { locale, slug: slugOf(post) },
        props: { post },
      }));
    })
  );

  return paths.flat();
}

const locale = Astro.params.locale as Locale;
const { post } = Astro.props;
const t = useTranslations(locale);
const { Content, headings } = await render(post);

const toc = headings.filter((heading) => heading.depth === 2);
const minutes = readingMinutes(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <Section width="prose">
    <a
      href={localizePath('/blog', locale)}
      class="inline-flex items-center gap-1.5 text-sm text-muted transition hover:text-text"
    >
      <Icon name="lucide:arrow-left" class="size-4" aria-hidden="true" />
      {t('blog.back')}
    </a>

    <article class="mt-6">
      <p class="font-mono text-xs text-muted">
        <time datetime={isoDate(post.data.publishDate)}>
          {formatDate(post.data.publishDate, locale)}
        </time>
        <span aria-hidden="true">·</span>
        {minutes}
        {t('blog.readingTime')}
      </p>

      <h1 class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">
        {post.data.title}
      </h1>
      <p class="mt-3 text-lg text-muted">{post.data.description}</p>

      <div class="mt-5 flex flex-wrap gap-2">
        {
          post.data.tags.map((tag) => (
            <a href={localizePath(`/blog/tag/${tag}`, locale)}>
              <Badge variant="outline">{tagLabel(tag, locale)}</Badge>
            </a>
          ))
        }
      </div>

      {
        toc.length > 2 && (
          <nav
            aria-label={t('blog.toc')}
            class="mt-8 rounded-xl border border-subtle bg-surface p-5"
          >
            <p class="mb-3 text-xs font-semibold tracking-wide text-muted uppercase">
              {t('blog.toc')}
            </p>
            <ol class="space-y-1.5 text-sm">
              {toc.map((heading) => (
                <li>
                  <a
                    href={`#${heading.slug}`}
                    class="text-muted transition hover:text-accent"
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      <Prose class="mt-10">
        <Content components={{ a: ContentLink }} />
      </Prose>

      {
        post.data.updatedDate && (
          <p class="mt-10 border-t border-subtle pt-6 font-mono text-xs text-muted">
            {t('blog.updated')}{' '}
            <time datetime={isoDate(post.data.updatedDate)}>
              {formatDate(post.data.updatedDate, locale)}
            </time>
          </p>
        )
      }
    </article>
  </Section>
</BaseLayout>
