---
import { Icon } from 'astro-icon/components';
import type { Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const options = [
  { value: 'light', icon: 'lucide:sun', label: t('theme.light') },
  { value: 'dark', icon: 'lucide:moon', label: t('theme.dark') },
  { value: 'system', icon: 'lucide:monitor', label: t('theme.system') },
] as const;
---

<div
  class="flex items-center gap-0.5 rounded-lg border border-subtle p-0.5"
  role="radiogroup"
  aria-label={t('theme.label')}
  data-theme-toggle
>
  {
    options.map((option) => (
      <button
        type="button"
        role="radio"
        aria-checked="false"
        tabindex="-1"
        aria-label={option.label}
        title={option.label}
        data-theme-option={option.value}
        class="cursor-pointer rounded-md p-1.5 text-muted transition hover:text-text aria-checked:bg-raised aria-checked:text-text"
      >
        <Icon name={option.icon} class="size-4" aria-hidden="true" />
      </button>
    ))
  }
</div>

<script>
  type Theme = 'light' | 'dark' | 'system';

  const options = [
    ...document.querySelectorAll<HTMLButtonElement>('[data-theme-option]'),
  ];

  function apply(theme: Theme) {
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    document.documentElement.dataset.theme = theme;
    document.documentElement.classList.toggle(
      'dark',
      theme === 'dark' || (theme === 'system' && prefersDark)
    );
  }

  function store(theme: Theme) {
    try {
      localStorage.setItem('theme', theme);
    } catch {
      return;
    }
  }

  function sync() {
    const current = (document.documentElement.dataset.theme ?? 'system') as Theme;
    for (const option of options) {
      const checked = option.dataset.themeOption === current;
      option.setAttribute('aria-checked', String(checked));
      option.tabIndex = checked ? 0 : -1;
    }
  }

  function choose(option: HTMLButtonElement, focus: boolean) {
    const theme = option.dataset.themeOption as Theme;
    store(theme);
    apply(theme);
    sync();
    if (focus) option.focus();
  }

  const moves: Record<string, (index: number) => number> = {
    ArrowRight: (index) => (index + 1) % options.length,
    ArrowDown: (index) => (index + 1) % options.length,
    ArrowLeft: (index) => (index - 1 + options.length) % options.length,
    ArrowUp: (index) => (index - 1 + options.length) % options.length,
    Home: () => 0,
    End: () => options.length - 1,
  };

  options.forEach((option, index) => {
    option.addEventListener('click', () => choose(option, false));
    option.addEventListener('keydown', (event) => {
      const move = moves[event.key];
      const target = move && options[move(index)];
      if (!target) return;
      event.preventDefault();
      choose(target, true);
    });
  });

  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    if (document.documentElement.dataset.theme === 'system') apply('system');
  });

  sync();
</script>
