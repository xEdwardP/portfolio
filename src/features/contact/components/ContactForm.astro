---
import { PUBLIC_WEB3FORMS_KEY } from 'astro:env/client';
import { limits } from '../schema';
import { createContactService } from '../service';
import type { Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const service = createContactService(PUBLIC_WEB3FORMS_KEY);

const fields = [
  {
    name: 'name',
    type: 'text',
    autocomplete: 'name',
    min: limits.name.min,
    max: limits.name.max,
  },
  { name: 'email', type: 'email', autocomplete: 'email', max: limits.email.max },
  {
    name: 'subject',
    type: 'text',
    autocomplete: 'off',
    min: limits.subject.min,
    max: limits.subject.max,
  },
  {
    name: 'message',
    type: 'textarea',
    autocomplete: 'off',
    min: limits.message.min,
    max: limits.message.max,
  },
] as const;

const control =
  'w-full rounded-lg border border-control bg-surface px-3 py-2 text-sm text-text transition placeholder:text-muted aria-[invalid=true]:border-danger';
---

<form
  data-contact-form
  data-locale={locale}
  action={service.formAction}
  method="post"
  class="grid gap-5 sm:grid-cols-2"
>
  {
    Object.entries(service.formFields).map(([name, value]) => (
      <input type="hidden" name={name} value={value} />
    ))
  }

  {
    fields.map((field) => (
      <div
        class:list={
          field.type === 'textarea' || field.name === 'subject' ? 'sm:col-span-2' : ''
        }
      >
        <label for={`contact-${field.name}`} class="mb-1.5 block text-sm font-medium">
          {t(`contact.field.${field.name}`)}
        </label>

        {field.type === 'textarea' ? (
          <textarea
            id={`contact-${field.name}`}
            name={field.name}
            data-field
            rows="6"
            required
            minlength={field.min}
            maxlength={field.max}
            class={control}
          />
        ) : (
          <input
            id={`contact-${field.name}`}
            name={field.name}
            data-field
            type={field.type}
            required
            minlength={'min' in field ? field.min : undefined}
            maxlength={field.max}
            autocomplete={field.autocomplete}
            spellcheck={field.type === 'email' ? 'false' : undefined}
            class={control}
          />
        )}

        <p id={`contact-${field.name}-error`} hidden class="mt-1.5 text-sm text-danger">
          {t(`contact.error.${field.name}`)}
        </p>
      </div>
    ))
  }

  <div class="absolute left-[-9999px]" aria-hidden="true">
    <label for="contact-company">{t('contact.honeypot')}</label>
    <input
      id="contact-company"
      name="company"
      type="text"
      tabindex="-1"
      autocomplete="off"
    />
  </div>

  <div class="sm:col-span-2">
    <p class="mb-2 text-sm font-medium">{t('contact.captcha.label')}</p>
    <div data-captcha></div>
    <p data-captcha-status class="mt-2 text-sm text-muted" aria-live="polite">
      {t('contact.captcha.loading')}
    </p>
  </div>

  <div class="flex flex-wrap items-center gap-4 sm:col-span-2">
    <button
      type="submit"
      data-submit
      class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-on-accent transition hover:bg-accent-hover disabled:cursor-not-allowed disabled:opacity-50"
    >
      <span data-label="idle">{t('contact.send')}</span>
      <span data-label="sending" hidden>{t('contact.sending')}</span>
    </button>
  </div>

  <div hidden data-messages>
    <span data-message="sending" data-tone="text-muted">{t('contact.sending')}</span>
    <span data-message="captchaThemeChanged" data-tone="text-muted"
      >{t('contact.captcha.themeChanged')}</span
    >
    <span data-message="captcha" data-tone="text-danger">{t('contact.fail.captcha')}</span
    >
    <span data-message="captchaExpired" data-tone="text-danger"
      >{t('contact.captcha.expired')}</span
    >
    <span data-message="captchaUnavailable" data-tone="text-danger"
      >{t('contact.captcha.unavailable')}</span
    >
    <span data-message="success" data-tone="text-success">{t('contact.success')}</span>
    <span data-message="misconfigured" data-tone="text-danger">
      {t('contact.fail.misconfigured')}
    </span>
    <span data-message="rejected" data-tone="text-danger"
      >{t('contact.fail.rejected')}</span
    >
    <span data-message="network" data-tone="text-danger">{t('contact.fail.network')}</span
    >
  </div>
</form>
<!-- Keep announcements outside the busy form so assistive technology can read them immediately. -->
<p
  class="mt-3 text-sm"
  role="status"
  aria-live="polite"
  aria-atomic="true"
  data-contact-status
>
</p>

<script>
  import { PUBLIC_WEB3FORMS_KEY } from 'astro:env/client';
  import { createContactService } from '@/features/contact/service';
  import { validate, type FieldName } from '@/features/contact/schema';

  type Control = HTMLInputElement | HTMLTextAreaElement;
  interface CaptchaApi {
    render(
      container: HTMLElement,
      options: {
        sitekey: string;
        hl: string;
        theme: string;
        size: string;
        callback: (token: string) => void;
        'expired-callback': () => void;
        'error-callback': () => void;
      }
    ): string;
    reset(id: string): void;
    remove(id: string): void;
  }
  const captchaWindow = window as typeof window & {
    hcaptcha?: CaptchaApi;
    contactCaptchaLoaded?: () => void;
  };

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  if (form) {
    const service = createContactService(PUBLIC_WEB3FORMS_KEY);
    const controls = [...form.querySelectorAll<Control>('[data-field]')];
    const status = document.querySelector<HTMLElement>('[data-contact-status]');
    const messages = form.querySelector<HTMLElement>('[data-messages]');
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]');
    const idle = form.querySelector<HTMLElement>('[data-label="idle"]');
    const sending = form.querySelector<HTMLElement>('[data-label="sending"]');
    const captcha = form.querySelector<HTMLElement>('[data-captcha]');
    const captchaStatus = form.querySelector<HTMLElement>('[data-captcha-status]');
    let captchaToken = '';
    let widgetId: string | undefined;
    let widgetTheme = '';
    let captchaFailed = false;
    let sendingRequest = false;

    const initialValues = controls.map((control) => control.value);
    const warnBeforeLeaving = (event: BeforeUnloadEvent) => {
      event.preventDefault();
    };
    const syncUnsaved = () => {
      const dirty = controls.some(
        (control, index) => control.value !== initialValues[index]
      );
      if (dirty) window.addEventListener('beforeunload', warnBeforeLeaving);
      else window.removeEventListener('beforeunload', warnBeforeLeaving);
    };
    form.addEventListener('input', syncUnsaved);
    window.addEventListener('pageshow', syncUnsaved);

    form.noValidate = true;

    const markInvalid = (control: Control, invalid: boolean) => {
      const error = document.getElementById(`${control.id}-error`);
      control.setAttribute('aria-invalid', String(invalid));

      if (invalid) control.setAttribute('aria-describedby', `${control.id}-error`);
      else control.removeAttribute('aria-describedby');

      if (error) error.hidden = !invalid;
    };

    const report = (kind: string) => {
      const source = messages?.querySelector<HTMLElement>(`[data-message="${kind}"]`);
      if (!status || !source) return;
      status.textContent = source.textContent?.trim() ?? '';
      status.className = `text-sm ${source.dataset.tone ?? ''}`;
    };

    const setSending = (active: boolean) => {
      sendingRequest = active;
      form.setAttribute('aria-busy', String(active));
      if (submit) submit.disabled = active;
      if (idle) idle.hidden = active;
      if (sending) sending.hidden = !active;
      if (active) report('sending');
    };

    const resetCaptcha = () => {
      captchaToken = '';
      if (widgetId !== undefined) captchaWindow.hcaptcha?.reset(widgetId);
    };

    const unavailable = () => {
      clearTimeout(loadTimeout);
      captchaToken = '';
      captchaFailed = true;
      if (captchaStatus) captchaStatus.hidden = true;
      report('captchaUnavailable');
    };

    // Register the callback before loading the API to avoid a script-load race.
    const renderCaptcha = () => {
      clearTimeout(loadTimeout);
      if (!captcha || !captchaWindow.hcaptcha || widgetId !== undefined) return;
      try {
        widgetTheme = document.documentElement.classList.contains('dark')
          ? 'dark'
          : 'light';
        captchaFailed = false;
        widgetId = captchaWindow.hcaptcha.render(captcha, {
          // Public site key provided by Web3Forms for its free-plan integration.
          sitekey: '50b2fe65-b00b-4b9e-ad62-3ba471098be2',
          hl: form.dataset.locale === 'en' ? 'en' : 'es',
          theme: widgetTheme,
          size: 'compact',
          callback: (token) => {
            captchaToken = token;
            if (status) status.textContent = '';
          },
          'expired-callback': () => {
            captchaToken = '';
            report('captchaExpired');
          },
          'error-callback': unavailable,
        });
        if (captchaStatus) captchaStatus.hidden = true;
        if (status) status.textContent = '';
      } catch {
        unavailable();
      }
    };
    captchaWindow.contactCaptchaLoaded = renderCaptcha;

    const syncCaptchaTheme = () => {
      const theme = document.documentElement.classList.contains('dark')
        ? 'dark'
        : 'light';
      if (sendingRequest || widgetId === undefined || theme === widgetTheme) return;
      const wasVerified = Boolean(captchaToken);
      captchaToken = '';
      captchaWindow.hcaptcha?.remove(widgetId);
      widgetId = undefined;
      renderCaptcha();
      if (wasVerified && !captchaFailed) report('captchaThemeChanged');
    };
    new MutationObserver(syncCaptchaTheme).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class'],
    });

    const captchaScript = document.createElement('script');
    captchaScript.src =
      'https://js.hcaptcha.com/1/api.js?render=explicit&onload=contactCaptchaLoaded&recaptchacompat=off';
    captchaScript.async = true;
    captchaScript.addEventListener('error', unavailable, { once: true });
    const loadTimeout = setTimeout(unavailable, 15000);
    document.head.append(captchaScript);

    for (const control of controls) {
      control.addEventListener('input', () => {
        if (control.getAttribute('aria-invalid') === 'true') markInvalid(control, false);
      });
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submit?.disabled) return;

      const data = new FormData(form);

      if (data.get('company')) {
        form.reset();
        syncUnsaved();
        resetCaptcha();
        report('success');
        return;
      }

      for (const control of controls) control.value = control.value.trim();

      const checked = validate(Object.fromEntries(data));
      const invalid = checked.ok ? [] : checked.invalid;

      for (const control of controls) {
        markInvalid(control, invalid.includes(control.name as FieldName));
      }

      if (!checked.ok) {
        controls.find((control) => control.name === invalid[0])?.focus();
        return;
      }

      if (!captchaToken) {
        report(captchaFailed ? 'captchaUnavailable' : 'captcha');
        captcha?.querySelector('iframe')?.focus();
        return;
      }

      setSending(true);

      const result = await service.send(checked.data, captchaToken);

      // Tokens are single-use, including after a failed or uncertain request.
      resetCaptcha();
      setSending(false);
      syncCaptchaTheme();

      if (result.ok) {
        const unchanged = controls.every(
          (control) => control.value.trim() === checked.data[control.name as FieldName]
        );
        if (unchanged) form.reset();
        syncUnsaved();
        report('success');
      } else {
        report(result.reason);
      }
    });
  }
</script>
