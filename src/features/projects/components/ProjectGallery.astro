---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { ImageMetadata } from 'astro';
import type { Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/utils';

interface Props {
  images: ImageMetadata[];
  title: string;
  locale: Locale;
}

const { images, title, locale } = Astro.props;
const t = useTranslations(locale);

const many = images.length > 1;

const control =
  'grid size-9 cursor-pointer place-items-center rounded-full border border-strong bg-surface text-muted transition hover:bg-raised hover:text-text disabled:cursor-not-allowed disabled:opacity-40';

const overlayControl =
  'grid size-10 cursor-pointer place-items-center rounded-full border border-on-overlay/20 bg-on-overlay/10 text-on-overlay backdrop-blur-sm transition hover:bg-on-overlay/25 disabled:cursor-not-allowed disabled:opacity-30';
---

{
  images.length > 0 && (
    <section data-gallery class="mt-8">
      <ul
        data-gallery-track
        tabindex="0"
        role="group"
        aria-label={`${t('project.gallery')}: ${title}`}
        class="no-scrollbar flex snap-x snap-mandatory gap-4 overflow-x-auto rounded-xl"
      >
        {images.map((image, index) => (
          <li class="w-full shrink-0 snap-center">
            <figure class="relative flex min-h-[240px] items-center justify-center rounded-xl border border-subtle bg-surface p-3 sm:min-h-[320px]">
              <Image
                src={image}
                alt={`${title}, ${t('project.screenshot')} ${index + 1}`}
                widths={[480, 800, 1200]}
                sizes="(min-width: 768px) 720px, 100vw"
                loading={index === 0 ? 'eager' : 'lazy'}
                class="max-h-[420px] w-auto rounded-lg object-contain"
              />

              <button
                type="button"
                hidden
                data-expand={index}
                aria-label={t('project.expand')}
                class="absolute top-5 right-5 grid size-9 cursor-pointer place-items-center rounded-lg border border-subtle bg-surface/90 text-muted backdrop-blur transition hover:text-text"
              >
                <Icon name="lucide:maximize-2" class="size-4" aria-hidden="true" />
              </button>
            </figure>
          </li>
        ))}
      </ul>

      {many && (
        <div
          hidden
          data-gallery-controls
          class="mt-3 flex items-center justify-between gap-4"
        >
          <div class="flex gap-2">
            <button
              type="button"
              data-gallery-prev
              aria-label={t('project.prevImage')}
              class={control}
            >
              <Icon name="lucide:arrow-left" class="size-4" aria-hidden="true" />
            </button>
            <button
              type="button"
              data-gallery-next
              aria-label={t('project.nextImage')}
              class={control}
            >
              <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
            </button>
          </div>

          <div class="flex gap-1.5">
            {images.map((_, index) => (
              <button
                type="button"
                data-gallery-dot={index}
                aria-label={`${t('project.goToImage')} ${index + 1}`}
                class="h-1.5 w-5 cursor-pointer rounded-full bg-strong transition aria-[current=true]:w-8 aria-[current=true]:bg-accent"
              />
            ))}
          </div>
        </div>
      )}

      <dialog
        data-lightbox
        aria-label={`${t('project.gallery')}: ${title}`}
        class="m-0 h-dvh max-h-none w-full max-w-none bg-transparent p-0 backdrop:bg-overlay/85 backdrop:backdrop-blur-sm"
      >
        <div class="flex h-full flex-col">
          <div class="flex items-center justify-between gap-4 px-4 py-4 sm:px-6">
            <p
              class="font-mono text-xs tracking-wide text-on-overlay/60 tabular-nums"
              data-lightbox-counter
              aria-live="polite"
            />
            <button
              type="button"
              data-lightbox-close
              aria-label={t('project.closeImage')}
              class={overlayControl}
            >
              <Icon name="lucide:x" class="size-5" aria-hidden="true" />
            </button>
          </div>

          <div class="flex min-h-0 flex-1 items-center justify-center px-4 sm:px-8">
            <img
              data-lightbox-image
              alt=""
              class="max-h-full max-w-full rounded-lg object-contain shadow-2xl ring-1 ring-on-overlay/10"
            />
          </div>

          <div class="flex items-center justify-center gap-3 px-4 py-5">
            {many && (
              <>
                <button
                  type="button"
                  data-lightbox-prev
                  aria-label={t('project.prevImage')}
                  class={overlayControl}
                >
                  <Icon name="lucide:arrow-left" class="size-5" aria-hidden="true" />
                </button>
                <button
                  type="button"
                  data-lightbox-next
                  aria-label={t('project.nextImage')}
                  class={overlayControl}
                >
                  <Icon name="lucide:arrow-right" class="size-5" aria-hidden="true" />
                </button>
              </>
            )}
          </div>
        </div>
      </dialog>
    </section>
  )
}

<script>
  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  const track = gallery?.querySelector<HTMLElement>('[data-gallery-track]');

  if (gallery && track) {
    const slides = [...track.children] as HTMLElement[];
    const sources = [...track.querySelectorAll<HTMLImageElement>('img')];
    const expanders = [...gallery.querySelectorAll<HTMLButtonElement>('[data-expand]')];

    const controls = gallery.querySelector<HTMLElement>('[data-gallery-controls]');
    const dots = [...gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-dot]')];
    const prev = gallery.querySelector<HTMLButtonElement>('[data-gallery-prev]');
    const next = gallery.querySelector<HTMLButtonElement>('[data-gallery-next]');

    const dialog = gallery.querySelector<HTMLDialogElement>('[data-lightbox]');
    const full = gallery.querySelector<HTMLImageElement>('[data-lightbox-image]');
    const counter = gallery.querySelector<HTMLElement>('[data-lightbox-counter]');
    const closeButton = gallery.querySelector<HTMLButtonElement>('[data-lightbox-close]');
    const fullPrev = gallery.querySelector<HTMLButtonElement>('[data-lightbox-prev]');
    const fullNext = gallery.querySelector<HTMLButtonElement>('[data-lightbox-next]');

    const current = () => Math.round(track.scrollLeft / track.clientWidth);
    const clamp = (index: number) => Math.max(0, Math.min(index, slides.length - 1));

    const goTo = (index: number) => {
      track.scrollTo({ left: clamp(index) * track.clientWidth, behavior: 'smooth' });
    };

    const sync = () => {
      const index = current();
      dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === index)));
      if (prev) prev.disabled = index === 0;
      if (next) next.disabled = index === slides.length - 1;
    };

    if (controls) {
      prev?.addEventListener('click', () => goTo(current() - 1));
      next?.addEventListener('click', () => goTo(current() + 1));
      dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));
      track.addEventListener('scroll', sync, { passive: true });
      controls.hidden = false;
      sync();
    }

    if (dialog && full) {
      let shown = 0;

      const show = (index: number) => {
        const source = sources[clamp(index)];
        if (!source) return;

        shown = clamp(index);
        full.src = source.currentSrc || source.src;
        full.srcset = source.srcset;
        full.sizes = '100vw';
        full.alt = source.alt;

        if (counter) counter.textContent = `${shown + 1} / ${sources.length}`;
        if (fullPrev) fullPrev.disabled = shown === 0;
        if (fullNext) fullNext.disabled = shown === sources.length - 1;
      };

      for (const expander of expanders) {
        expander.hidden = false;
        expander.addEventListener('click', () => {
          show(Number(expander.dataset.expand));
          dialog.showModal();
        });
      }

      closeButton?.addEventListener('click', () => dialog.close());
      fullPrev?.addEventListener('click', () => show(shown - 1));
      fullNext?.addEventListener('click', () => show(shown + 1));

      dialog.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') show(shown - 1);
        if (event.key === 'ArrowRight') show(shown + 1);
      });

      dialog.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        if (target === full || target.closest('button')) return;
        dialog.close();
      });

      dialog.addEventListener('close', () => goTo(shown));
    }
  }
</script>
