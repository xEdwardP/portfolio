---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Badge from '@/shared/components/ui/Badge.astro';
import Card from '@/shared/components/ui/Card.astro';
import { ecosystems } from '@/data/profile';
import type { Locale } from '@/i18n/config';
import { localizePath, useTranslations } from '@/i18n/utils';
import { slugOf, type Project } from '@/features/projects/queries';
import { coverFor } from '@/features/projects/gallery';

interface Props {
  project: Project;
  locale: Locale;
  headingLevel?: 2 | 3;
}

const { project, locale, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const t = useTranslations(locale);
const { data } = project;

const slug = slugOf(project);
const ecosystem = ecosystems.find((item) => item.id === data.ecosystem);
const href = localizePath(`/projects/${slug}`, locale);
const isCaseStudy = data.tier === 'case-study';
const visibleStack = data.stack.slice(0, 3);
const remaining = data.stack.length - visibleStack.length;
const cover = coverFor(slug);
---

<Card interactive padded={false} class="flex h-full reveal flex-col overflow-hidden">
  <div class:list={['h-1 w-full shrink-0', ecosystem?.bar]}></div>

  <div
    class:list={[
      'relative flex aspect-[16/10] items-center justify-center overflow-hidden border-b border-subtle bg-gradient-to-br to-transparent',
      ecosystem?.tint,
    ]}
  >
    {
      cover ? (
        <Image
          src={cover}
          alt=""
          widths={[320, 640]}
          sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw"
          loading="lazy"
          class="size-full object-cover transition duration-300 group-hover:scale-[1.03]"
        />
      ) : (
        ecosystem && (
          <Icon
            name={ecosystem.icon}
            class:list={[
              'size-14 opacity-25 transition duration-300 group-hover:opacity-40',
              ecosystem.color,
            ]}
            aria-hidden="true"
          />
        )
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-5">
    <div class="mb-2 flex items-start justify-between gap-3">
      <Heading class="font-display text-lg font-semibold tracking-tight">
        <a
          href={href}
          class="transition group-hover:text-accent after:absolute after:inset-0"
        >
          {data.title}
        </a>
      </Heading>
      {isCaseStudy && <Badge variant="outline">{t('projects.caseStudy')}</Badge>}
    </div>

    <p class="mb-4 flex-1 text-sm text-muted">{data.summary}</p>

    <div class="flex flex-wrap items-center gap-2">
      {
        ecosystem && (
          <span
            class:list={[
              'inline-flex items-center gap-1.5 text-xs font-medium',
              ecosystem.color,
            ]}
          >
            <Icon name={ecosystem.icon} class="size-3.5" aria-hidden="true" />
            {ecosystem.label}
          </span>
        )
      }
      {visibleStack.map((tech) => <Badge>{tech}</Badge>)}
      {remaining > 0 && <Badge variant="outline">+{remaining}</Badge>}
    </div>
  </div>
</Card>

<style>
  article {
    position: relative;
  }
</style>
