---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'article'> {
  interactive?: boolean;
}

const { interactive = false, class: className, ...rest } = Astro.props;
---

<article
  class:list={[
    'rounded-xl border border-subtle bg-surface p-5',
    interactive &&
      'group transition duration-200 hover:-translate-y-0.5 hover:border-strong hover:shadow-lg hover:shadow-black/5',
    className,
  ]}
  {...rest}
>
  <slot />
</article>
