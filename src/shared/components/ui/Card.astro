---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'article'> {
  interactive?: boolean;
  padded?: boolean;
}

const { interactive = false, padded = true, class: className, ...rest } = Astro.props;
---

<article
  class:list={[
    'rounded-xl border border-subtle bg-surface',
    padded && 'p-5',
    interactive &&
      'group transition duration-200 focus-within:-translate-y-0.5 focus-within:border-strong focus-within:shadow-lg focus-within:shadow-overlay/10 hover:-translate-y-0.5 hover:border-strong hover:shadow-lg hover:shadow-overlay/10',
    className,
  ]}
  {...rest}
>
  <slot />
</article>
