---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'article'> {
  interactive?: boolean;
}

const { interactive = false, class: className, ...rest } = Astro.props;
---

<article
  class:list={[
    'rounded-xl border border-subtle bg-surface p-5',
    interactive && 'group transition hover:border-strong',
    className,
  ]}
  {...rest}
>
  <slot />
</article>
