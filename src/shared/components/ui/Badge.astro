---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'neutral' | 'accent' | 'outline';

interface Props extends HTMLAttributes<'span'> {
  variant?: Variant;
}

const { variant = 'neutral', class: className, ...rest } = Astro.props;

const variants: Record<Variant, string> = {
  neutral: 'bg-raised text-muted',
  accent: 'bg-accent text-on-accent',
  outline: 'border border-strong text-muted',
};
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-md px-2 py-0.5 font-mono text-xs',
    variants[variant],
    className,
  ]}
  {...rest}
>
  <slot />
</span>
