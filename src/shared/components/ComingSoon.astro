---
import Section from '@/shared/components/ui/Section.astro';
import type { Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/utils';

interface Props {
  locale: Locale;
  title: string;
}

const { locale, title } = Astro.props;
const t = useTranslations(locale);
---

<Section width="prose" class="py-20">
  <h1 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
  <p class="mt-4 text-muted">{t('soon.body')}</p>
</Section>
