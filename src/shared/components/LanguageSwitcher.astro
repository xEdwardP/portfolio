---
import { localeNames, type Locale } from '@/i18n/config';
import { otherLocale, switchLocalePath, useTranslations } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const target = otherLocale(locale);
const href = switchLocalePath(Astro.url.pathname, target);
---

<a
  href={href}
  hreflang={target}
  aria-label={t('lang.switch')}
  class="rounded-lg border border-subtle px-2.5 py-1.5 font-mono text-xs font-medium text-muted transition hover:bg-raised hover:text-text"
>
  <span aria-hidden="true">{target.toUpperCase()}</span>
  <span class="sr-only">{localeNames[target]}</span>
</a>
