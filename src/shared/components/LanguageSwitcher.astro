---
import { localeNames, type Locale } from '@/i18n/config';
import { otherLocale, switchLocalePath, useTranslations } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const target = otherLocale(locale);
const href = switchLocalePath(Astro.url.pathname, target);
---

<a
  data-language-switch={target}
  href={href}
  hreflang={target}
  aria-label={t('lang.switch')}
  class="rounded-lg border border-subtle px-2.5 py-1.5 font-mono text-xs font-medium text-muted transition hover:bg-raised hover:text-text"
>
  <span aria-hidden="true">{target.toUpperCase()}</span>
  <span class="sr-only">{localeNames[target]}</span>
</a>

<script>
  import { isLocale } from '@/i18n/config';
  import { switchLocalePath } from '@/i18n/utils';

  const link = document.querySelector<HTMLAnchorElement>('[data-language-switch]');
  const sync = () => {
    const target = link?.dataset.languageSwitch;
    if (link && target && isLocale(target)) {
      link.href = switchLocalePath(
        window.location.pathname + window.location.search,
        target
      );
    }
  };

  sync();
  for (const event of [
    'focus',
    'pointerenter',
    'pointerdown',
    'click',
    'auxclick',
    'contextmenu',
  ]) {
    link?.addEventListener(event, sync);
  }
  window.addEventListener('popstate', sync);
</script>
